<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.bupt.lams.mapper.AdvisoryMapper">
    <insert id="insertSelective" parameterType="com.bupt.lams.model.planItem.Advisory" useGeneratedKeys="true"
            keyProperty="id">
        insert into advisory
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="itemType != null">
                `itemType`,
            </if>
            <if test="itemTypeName != null and itemTypeName != ''">
                itemTypeName,
            </if>
            <if test="userEmail != null and userEmail != ''">
                userEmail,
            </if>
            <if test="personnelType != null and personnelType != ''">
                `personnelType`,
            </if>
            <if test="content != null and content != ''">
                `content`,
            </if>
            <if test="amount != null">
                amount,
            </if>
            <if test="standard != null">
                standard,
            </if>
            <if test="days != null">
                days,
            </if>
            <if test="subTotal != null">
                subTotal,
            </if>
            <if test="remark != null and remark != ''">
                remark,
            </if>
            <if test="unfulfilledQuota != null">
                unfulfilledQuota,
            </if>
            <if test="executeRate != null">
                executeRate,
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="itemType != null">
                #{itemType},
            </if>
            <if test="itemTypeName != null and itemTypeName != ''">
                #{itemTypeName},
            </if>
            <if test="userEmail != null and userEmail != ''">
                #{userEmail},
            </if>
            <if test="personnelType != null and personnelType != ''">
                #{personnelType},
            </if>
            <if test="content != null and content != ''">
                #{content},
            </if>
            <if test="amount != null">
                #{amount},
            </if>
            <if test="standard != null">
                #{standard},
            </if>
            <if test="days != null">
                #{days},
            </if>
            <if test="subTotal != null">
                #{subTotal},
            </if>
            <if test="remark != null and remark != ''">
                #{remark},
            </if>
            <if test="unfulfilledQuota != null">
                #{unfulfilledQuota},
            </if>
            <if test="executeRate != null">
                #{executeRate},
            </if>
        </trim>
    </insert>
    <update id="update" parameterType="com.bupt.lams.model.planItem.Advisory">
        update advisory
        set
        <trim suffixOverrides=",">
            <if test="itemType != null">
                itemType = #{itemType},
            </if>
            <if test="itemTypeName != null and itemTypeName != ''">
                itemTypeName = #{itemTypeName},
            </if>
            <if test="personnelType != null and personnelType != ''">
                personnelType = #{personnelType},
            </if>
            <if test="content != null and content != ''">
                content = #{content},
            </if>
            <if test="amount != null">
                amount = #{amount},
            </if>
            <if test="standard != null">
                standard = #{standard},
            </if>
            <if test="days != null">
                days = #{days},
            </if>
            <if test="subTotal != null">
                subTotal = #{subTotal},
            </if>
            <if test="remark != null and remark != ''">
                remark = #{remark},
            </if>
            <if test="unfulfilledQuota != null">
                unfulfilledQuota = #{unfulfilledQuota},
            </if>
            <if test="executeRate != null">
                executeRate = #{executeRate},
            </if>
            <if test="createTime != null">
                createTime = #{createTime},
            </if>
            updateTime = NOW()
        </trim>
        <where>
            id = #{id}
        </where>
    </update>
    <select id="getById" parameterType="java.lang.Long" resultType="com.bupt.lams.model.planItem.Advisory">
        select t.*, p.id as planId, pr.id as projectId, p.planName, pr.projectName
        from
        advisory t
        join plan_item pi on t.id = pi.iid
        join plan p on  p.id = pi.pid
        join project pr on pr.id = p.projectId
        where
        pi.itid = 10
        and
        t.id = #{id}
    </select>
    <select id="getAdvisoryByIds" parameterType="list" resultType="com.bupt.lams.model.planItem.Advisory">
        select a.*
        from
        advisory a
        where 1=1
        <if test="list != null and list.size>0">
            and a.id in
            <foreach collection="list" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
        </if>
        order by a.id
    </select>
    <select id="getFullInfoByIds" parameterType="list" resultType="com.bupt.lams.model.planItem.Advisory">
        select t.*, p.id as planId, pr.id as projectId, p.planName, pr.projectName
        from
        advisory t
        join plan_item pi on t.id = pi.iid
        join plan p on  p.id = pi.pid
        join project pr on pr.id = p.projectId
        where pi.itid = 10
        <if test="list != null and list.size>0">
            and t.id in
            <foreach collection="list" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
        </if>
        order by t.id
    </select>
    <delete id="clear" parameterType="java.lang.String">
        delete a.*
        from advisory a
        left join plan_item p on p.iid = a.id
        where
        p.pid is null
        and a.itemType = 10
        and a.userEmail = #{userEmail};
    </delete>
    <select id="getAll" resultType="com.bupt.lams.model.planItem.Advisory">
        select t.*, p.id as planId, pr.id as projectId, p.planName, pr.projectName
        from
        advisory t
        join plan_item pi on t.id = pi.iid
        join plan p on  p.id = pi.pid
        join project pr on pr.id = p.projectId
        where
        pi.itid = 10
        and
        p.isDeleted = 0
        order by t.id
    </select>
</mapper>