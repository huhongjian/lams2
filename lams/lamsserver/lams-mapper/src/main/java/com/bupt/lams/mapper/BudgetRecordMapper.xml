<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.bupt.lams.mapper.BudgetRecordMapper">
    <resultMap id="BaseResultMap" type="com.bupt.lams.model.BudgetRecord">
        <id column="id" property="id"/>
        <result column="funding" property="funding"/>
        <result column="projectId" property="projectId"/>
        <result column="projectName" property="projectName"/>
        <result column="planId" property="planId"/>
        <result column="planName" property="planName"/>
        <result column="planItemId" property="planItemId"/>
        <result column="itemType" property="itemType"/>
        <result column="itemTypeName" property="itemTypeName"/>
        <result column="remark" property="remark"/>
        <result column="userEmail" property="userEmail"/>
        <result column="executeDate" property="executeDate"/>
        <result column="createTime" property="createTime"/>
        <result column="updateTime" property="updateTime"/>
    </resultMap>
    <resultMap id="AllInfoResultMap" type="com.bupt.lams.model.BudgetRecord" extends="BaseResultMap">
        <association property="user" javaType="com.bupt.lams.model.LamsUser">
            <id column="uid" property="id"/>
            <result column="name" property="name"/>
            <result column="phone" property="phone"/>
            <result column="username" property="username"/>
            <result column="enabled" property="enabled"/>
            <result column="remark" property="remark"/>
        </association>
    </resultMap>
    <sql id="baseInfoQuery">
        <if test="id !=null">
            and b.id = #{id}
        </if>
        <if test="itemType !=null">
            and b.itemType = #{itemType}
        </if>
        <if test="planItemId !=null">
            and b.planItemId = #{planItemId}
        </if>
        <if test="userEmail !=null and userEmail!=''">
            and b.userEmail like concat('%',#{userEmail},'%')
        </if>
        <if test="planName !=null and planName!=''">
            and b.planName like concat('%',#{planName},'%')
        </if>
        <if test="projectId !=null">
            and b.projectId = #{projectId}
        </if>
        <if test="startDate !=null and endDate !=null">
            and b.executeDate between #{startDate} and #{endDate}
        </if>
    </sql>
    <select id="getBudgetRecordByCondition" parameterType="com.bupt.lams.dto.ProjectQueryCondition"
            resultMap="AllInfoResultMap">
        select b.*,
        u.id as uid, u.*
        from
        budget_record b
        left join lams_user u on b.userEmail = u.username
        <where>
            <include refid="baseInfoQuery"/>
        </where>
        order by b.id
    </select>
    <insert id="insertSelective" parameterType="com.bupt.lams.model.BudgetRecord" useGeneratedKeys="true"
            keyProperty="id">
        insert into budget_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="funding != null">
                funding,
            </if>
            <if test="projectId != null">
                projectId,
            </if>
            <if test="projectName != null and projectName != ''">
                projectName,
            </if>
            <if test="planId != null">
                planId,
            </if>
            <if test="planName != null and planName != ''">
                `planName`,
            </if>
            <if test="planItemId != null">
                planItemId,
            </if>
            <if test="itemType != null">
                itemType,
            </if>
            <if test="itemTypeName != null and itemTypeName != ''">
                `itemTypeName`,
            </if>
            <if test="remark != null and remark != ''">
                remark,
            </if>
            <if test="userEmail != null and userEmail != ''">
                userEmail,
            </if>
            <if test="executeDate != null">
                executeDate,
            </if>
            <if test="createTime != null">
                createTime,
            </if>
            <if test="updateTime != null">
                updateTime,
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="funding != null">
                #{funding},
            </if>
            <if test="projectId != null">
                #{projectId},
            </if>
            <if test="projectName != null and projectName != ''">
                #{projectName},
            </if>
            <if test="planId != null">
                #{planId},
            </if>
            <if test="planName != null and planName != ''">
                #{planName},
            </if>
            <if test="planItemId != null">
                #{planItemId},
            </if>
            <if test="itemType != null">
                #{itemType},
            </if>
            <if test="itemTypeName != null and itemTypeName != ''">
                #{itemTypeName},
            </if>
            <if test="remark != null and remark != ''">
                #{remark},
            </if>
            <if test="userEmail != null and userEmail != ''">
                #{userEmail},
            </if>
            <if test="executeDate != null">
                #{executeDate},
            </if>
            <if test="createTime != null">
                #{createTime},
            </if>
            <if test="updateTime != null">
                #{updateTime},
            </if>
        </trim>
    </insert>
    <select id="getByIds" parameterType="list" resultMap="BaseResultMap">
        select b.*
        from
        budget_record b
        where 1=1
        <if test="list != null and list.size>0">
            and b.id in
            <foreach collection="list" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
        </if>
        order by b.id
    </select>
    <delete id="deleteManyByIds" parameterType="list">
        delete
        from budget_record
        where
        id in
        <foreach collection="list" close=")" open="(" separator="," item="item">
            #{item}
        </foreach>
    </delete>
    <select id="getRecentIdByItemType" resultType="java.lang.Long">
        select b.planItemId
        from
        budget_record b
        where
        b.itemType = #{type}
        and b.userEmail = #{userEmail}
        order by b.id desc
        limit 1
    </select>
</mapper>