<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.bupt.lams.mapper.EquipmentFeeMapper">
    <insert id="insertSelective" parameterType="com.bupt.lams.model.planItem.EquipmentFee" useGeneratedKeys="true"
            keyProperty="id">
        insert into equipment_fee
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="itemType != null">
                `itemType`,
            </if>
            <if test="itemTypeName != null and itemTypeName != ''">
                itemTypeName,
            </if>
            <if test="userEmail != null and userEmail != ''">
                userEmail,
            </if>
            <if test="equipmentName != null and equipmentName != ''">
                equipmentName,
            </if>
            <if test="remark != null and remark != ''">
                remark,
            </if>
            <if test="usage != null and usage != ''">
                `usage`,
            </if>
            <if test="amount != null">
                amount,
            </if>
            <if test="unitPrice != null">
                unitPrice,
            </if>
            <if test="subTotal != null">
                subTotal,
            </if>
            <if test="unfulfilledQuota != null">
                unfulfilledQuota,
            </if>
            <if test="executeRate != null">
                executeRate,
            </if>
            <if test="createTime != null">
                createTime,
            </if>
            <if test="updateTime != null">
                updateTime,
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="itemType != null">
                #{itemType},
            </if>
            <if test="itemTypeName != null and itemTypeName != ''">
                #{itemTypeName},
            </if>
            <if test="userEmail != null and userEmail != ''">
                #{userEmail},
            </if>
            <if test="remark != null and remark != ''">
                #{remark},
            </if>
            <if test="equipmentName != null and equipmentName != ''">
                #{equipmentName},
            </if>
            <if test="usage != null and usage != ''">
                #{usage},
            </if>
            <if test="amount != null">
                #{amount},
            </if>
            <if test="unitPrice != null">
                #{unitPrice},
            </if>
            <if test="subTotal != null">
                #{subTotal},
            </if>
            <if test="unfulfilledQuota != null">
                #{unfulfilledQuota},
            </if>
            <if test="executeRate != null">
                #{executeRate},
            </if>
            <if test="createTime != null">
                #{createTime},
            </if>
            <if test="updateTime != null">
                #{updateTime},
            </if>
        </trim>
    </insert>
    <select id="getEquipmentFeeByIds" parameterType="list" resultType="com.bupt.lams.model.planItem.EquipmentFee">
        select e.*
        from
        equipment_fee e
        where 1=1
        <if test="list != null and list.size>0">
            and e.id in
            <foreach collection="list" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
        </if>
        order by e.id
    </select>
    <select id="getFullInfoByIds" parameterType="list" resultType="com.bupt.lams.model.planItem.EquipmentFee">
        select e.*, p.id as planId, pr.id as projectId, p.planName, pr.projectName
        from
        equipment_fee e
        join plan_item pi on e.id = pi.iid
        join plan p on p.id = pi.pid
        join project pr on pr.id = p.projectId
        where pi.itid = 1
        <if test="list != null and list.size>0">
            and e.id in
            <foreach collection="list" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
        </if>
        order by e.id
    </select>
    <update id="update" parameterType="com.bupt.lams.model.planItem.EquipmentFee">
        update equipment_fee
        set
        <trim suffixOverrides=",">
            <if test="itemType != null">
                `itemType` = #{itemType},
            </if>
            <if test="itemTypeName != null and itemTypeName != ''">
                itemTypeName = #{itemTypeName},
            </if>
            <if test="equipmentName != null and equipmentName != ''">
                `equipmentName` = #{equipmentName},
            </if>
            <if test="usage != null and usage != ''">
                `usage` = #{usage},
            </if>
            <if test="amount != null">
                amount = #{amount},
            </if>
            <if test="unitPrice != null">
                unitPrice = #{unitPrice},
            </if>
            <if test="subTotal != null">
                subTotal = #{subTotal},
            </if>
            <if test="unfulfilledQuota != null">
                unfulfilledQuota = #{unfulfilledQuota},
            </if>
            <if test="executeRate != null">
                executeRate = #{executeRate},
            </if>
            <if test="createTime != null">
                createTime = #{createTime},
            </if>
            updateTime = NOW()
        </trim>
        <where>
            id = #{id}
        </where>
    </update>
    <select id="getById" parameterType="java.lang.Long" resultType="com.bupt.lams.model.planItem.EquipmentFee">
        select e.*
        from
        equipment_fee e
        where
        e.id = #{id}
    </select>
    <delete id="clear" parameterType="java.lang.String">
        delete e.*
        from equipment_fee e
         left join plan_item p on p.iid = e.id
        where
        p.pid is null
        and e.itemType = 1
        and e.userEmail = #{userEmail};
    </delete>
    <select id="getByPlanId" parameterType="java.lang.Long" resultType="com.bupt.lams.model.planItem.EquipmentFee">
        select e.*, p.id as planId, pr.id as projectId, p.planName, pr.projectName
        from
        equipment_fee e
        join plan_item pi on e.id = pi.iid
        join plan p on  p.id = pi.pid
        join project po on po.id = p.projectId
        where
        pi.itid = 1
        and
        pi.pid = #{pid}
        order by e.id
    </select>

    <select id="getAll" resultType="com.bupt.lams.model.planItem.EquipmentFee">
        select e.*, p.id as planId, pr.id as projectId, p.planName, pr.projectName
        from
        equipment_fee e
        join plan_item pi on e.id = pi.iid
        join plan p on  p.id = pi.pid
        join project pr on pr.id = p.projectId
        where
        pi.itid = 1
        and
        p.isDeleted = 0
        order by e.id
    </select>
</mapper>