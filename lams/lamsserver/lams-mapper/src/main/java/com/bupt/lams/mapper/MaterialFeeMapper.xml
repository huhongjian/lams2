<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.bupt.lams.mapper.MaterialFeeMapper">
    <insert id="insertSelective" parameterType="com.bupt.lams.model.planItem.MaterialFee" useGeneratedKeys="true"
            keyProperty="id">
        insert into material_fee
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="itemType != null">
                `itemType`,
            </if>
            <if test="itemTypeName != null and itemTypeName != ''">
                itemTypeName,
            </if>
            <if test="userEmail != null and userEmail != ''">
                userEmail,
            </if>
            <if test="usage != null and usage != ''">
                `usage`,
            </if>
            <if test="remark != null and remark != ''">
                `remark`,
            </if>
            <if test="materialName != null and materialName != ''">
                materialName,
            </if>
            <if test="specification != null and specification != ''">
                specification,
            </if>
            <if test="unit != null and unit != ''">
                unit,
            </if>
            <if test="amount != null">
                amount,
            </if>
            <if test="unitPrice != null">
                unitPrice,
            </if>
            <if test="subTotal != null">
                subTotal,
            </if>
            <if test="unfulfilledQuota != null">
                unfulfilledQuota,
            </if>
            <if test="executeRate != null">
                executeRate,
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="itemType != null">
                #{itemType},
            </if>
            <if test="itemTypeName != null and itemTypeName != ''">
                #{itemTypeName},
            </if>
            <if test="userEmail != null and userEmail != ''">
                #{userEmail},
            </if>
            <if test="remark != null and remark != ''">
                #{remark},
            </if>
            <if test="usage != null and usage != ''">
                #{usage},
            </if>
            <if test="materialName != null and materialName != ''">
                #{materialName},
            </if>
            <if test="specification != null and specification != ''">
                #{specification},
            </if>
            <if test="unit != null and unit != ''">
                #{unit},
            </if>
            <if test="amount != null">
                #{amount},
            </if>
            <if test="unitPrice != null">
                #{unitPrice},
            </if>
            <if test="subTotal != null">
                #{subTotal},
            </if>
            <if test="unfulfilledQuota != null">
                #{unfulfilledQuota},
            </if>
            <if test="executeRate != null">
                #{executeRate},
            </if>
        </trim>
    </insert>
    <update id="update" parameterType="com.bupt.lams.model.planItem.MaterialFee">
        update material_fee
        set
        <trim suffixOverrides=",">
            <if test="itemType != null">
                `itemType` = #{itemType},
            </if>
            <if test="itemTypeName != null and itemTypeName != ''">
                itemTypeName = #{itemTypeName},
            </if>
            <if test="remark != null and remark != ''">
                remark = #{remark},
            </if>
            <if test="usage != null and usage != ''">
                `usage` = #{usage},
            </if>
            <if test="materialName != null and materialName != ''">
                materialName = #{materialName},
            </if>
            <if test="specification != null and specification != ''">
                specification = #{specification},
            </if>
            <if test="unit != null and unit != ''">
                unit = #{unit},
            </if>
            <if test="amount != null">
                amount = #{amount},
            </if>
            <if test="unitPrice != null">
                unitPrice = #{unitPrice},
            </if>
            <if test="subTotal != null">
                subTotal = #{subTotal},
            </if>
            <if test="unfulfilledQuota != null">
                unfulfilledQuota = #{unfulfilledQuota},
            </if>
            <if test="executeRate != null">
                executeRate = #{executeRate},
            </if>
            <if test="createTime != null">
                createTime = #{createTime},
            </if>
            updateTime = NOW()
        </trim>
        <where>
            id = #{id}
        </where>
    </update>
    <select id="getById" parameterType="java.lang.Long" resultType="com.bupt.lams.model.planItem.MaterialFee">
        select t.*, p.id as planId, pr.id as projectId, p.planName, pr.projectName
        from
        material_fee t
        join plan_item pi on t.id = pi.iid
        join plan p on  p.id = pi.pid
        join project pr on pr.id = p.projectId
        where
        pi.itid = 2
        and
        t.id = #{id}
    </select>
    <select id="getMaterialFeeByIds" parameterType="list" resultType="com.bupt.lams.model.planItem.MaterialFee">
        select m.*
        from
        material_fee m
        where 1=1
        <if test="list != null and list.size>0">
            and m.id in
            <foreach collection="list" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
        </if>
        order by m.id
    </select>
    <select id="getFullInfoByIds" parameterType="list" resultType="com.bupt.lams.model.planItem.MaterialFee">
        select t.*, p.id as planId, pr.id as projectId, p.planName, pr.projectName
        from
        material_fee t
        join plan_item pi on t.id = pi.iid
        join plan p on p.id = pi.pid
        join project pr on pr.id = p.projectId
        where pi.itid = 2
        <if test="list != null and list.size>0">
            and t.id in
            <foreach collection="list" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
        </if>
        order by t.id
    </select>
    <delete id="clear" parameterType="java.lang.String">
        delete m.*
        from material_fee m
         left join plan_item p on p.iid = m.id
        where
        p.pid is null
        and m.itemType = 2
        and m.userEmail = #{userEmail};
    </delete>
    <select id="getAll" resultType="com.bupt.lams.model.planItem.MaterialFee">
        select t.*, p.id as planId, pr.id as projectId, p.planName, pr.projectName
        from
        material_fee t
        join plan_item pi on t.id = pi.iid
        join plan p on  p.id = pi.pid
        join project pr on pr.id = p.projectId
        where
        pi.itid = 2
        and
        p.isDeleted = 0
        order by t.id
    </select>
</mapper>