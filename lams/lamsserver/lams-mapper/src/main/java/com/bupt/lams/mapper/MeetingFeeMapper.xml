    <select id="getMeetingFeeByIds" parameterType="list" resultType="com.bupt.lams.model.planItem.MeetingFee">
        select m.*
        from
        meeting_fee m
        where 1=1
        <if test="list != null and list.size>0">
            and m.id in
            <foreach collection="list" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
        </if>
        order by m.id
    </select>
    <select id="getFullInfoByIds" parameterType="list" resultType="com.bupt.lams.model.planItem.MeetingFee">
        select t.*, p.id as planId, pr.id as projectId, p.planName, pr.projectName
        from
        meeting_fee t
        join plan_item pi on t.id = pi.iid
        join plan p on p.id = pi.pid
        join project pr on pr.id = p.projectId
        where pi.itid = 4
        <if test="list != null and list.size>0">
            and t.id in
            <foreach collection="list" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
        </if>
        order by t.id
    </select>
    <delete id="clear" parameterType="java.lang.String">
        delete m.*
        from meeting_fee m
         left join plan_item p on p.iid = m.id
        where
        p.pid is null
        and m.itemType = 4
        and m.userEmail = #{userEmail};
    </delete>
    <select id="getAll" resultType="com.bupt.lams.model.planItem.MeetingFee">
        select t.*, p.id as planId, pr.id as projectId, p.planName, pr.projectName
        from
        meeting_fee t
        join plan_item pi on t.id = pi.iid
        join plan p on  p.id = pi.pid
        join project pr on pr.id = p.projectId
        where
        pi.itid = 4
        and
        p.isDeleted = 0
        order by t.id
    </select>
