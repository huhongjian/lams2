<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bupt.lams.mapper.MessageContentMapper">
    <update id="updateMailSendLogStatus">
        update mail_send_log set status = #{status} where msgId=#{msgId};
    </update>
    <insert id="insert" parameterType="com.bupt.lams.model.MessageContent" useGeneratedKeys="true" keyProperty="id">
        insert into message_content (toEmail,projectName,planName,itemTypeName,executeRate,needExecuteRate)
        values (#{toEmail},#{projectName},#{planName},#{itemTypeName},#{executeRate},#{needExecuteRate});
    </insert>

    <select id="getContentById" parameterType="java.lang.Long" resultType="com.bupt.lams.model.MessageContent">
        select * from message_content where id = #{id}
    </select>
    <update id="updateCount">
        update message_send_log set count=count+1,updateTime=#{date} where msgId=#{msgId};
    </update>
</mapper>