<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bupt.lams.mapper.MessageContentMapper">
    <sql id="baseInfoQuery">
        <if test="id !=null">
            and m.id = #{id}
        </if>
        <if test="projectName !=null and projectName!=''">
            and m.projectName like concat('%',#{projectName},'%')
        </if>
        <if test="planName !=null and planName!=''">
            and m.planName like concat('%',#{planName},'%')
        </if>
        <if test="itemTypeName !=null and itemTypeName!=''">
            and m.itemTypeName like concat('%',#{itemTypeName},'%')
        </if>
        <if test="userEmail !=null and userEmail!=''">
            and m.toEmail like concat('%',#{userEmail},'%')
        </if>
        <if test="startDate !=null and endDate !=null">
            and m.createTime between #{startDate} and #{endDate}
        </if>
    </sql>
    <select id="getByCondition" parameterType="com.bupt.lams.dto.WarningRecordQueryCondition"
            resultType="com.bupt.lams.model.MessageContent">
        select m.*
        from
        message_content m
        <where>
            <include refid="baseInfoQuery"/>
        </where>
        order by m.id
    </select>
    <update id="updateMailSendLogStatus">
        update mail_send_log set status = #{status} where msgId=#{msgId};
    </update>
    <insert id="insert" parameterType="com.bupt.lams.model.MessageContent" useGeneratedKeys="true" keyProperty="id">
        insert into message_content (toEmail,projectName,planName,itemTypeName,executeRate,needExecuteRate)
        values (#{toEmail},#{projectName},#{planName},#{itemTypeName},#{executeRate},#{needExecuteRate});
    </insert>

    <select id="getContentById" parameterType="java.lang.Long" resultType="com.bupt.lams.model.MessageContent">
        select * from message_content where id = #{id}
    </select>
    <update id="updateCount">
        update message_send_log set count=count+1,updateTime=#{date} where msgId=#{msgId};
    </update>
</mapper>