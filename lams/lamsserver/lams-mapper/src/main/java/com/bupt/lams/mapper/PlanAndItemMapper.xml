<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.bupt.lams.mapper.PlanAndItemMapper">
    <resultMap id="BaseResultMap" type="com.bupt.lams.model.OrderAsset">
        <id column="id" property="id"/>
        <result column="oid" property="oid"/>
        <result column="aid" property="aid"/>
        <result column="createTime" property="createTime"/>
        <result column="updateTime" property="updateTime"/>
    </resultMap>
    <insert id="insertSelective" parameterType="com.bupt.lams.model.PlanAndItem" useGeneratedKeys="true"
            keyProperty="id">
        insert into plan_item
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">
                id,
            </if>
            <if test="pid != null">
                pid,
            </if>
            <if test="itid != null">
                iid,
            </if>
            <if test="iid != null">
                iid,
            </if>
            <if test="createTime != null">
                createTime,
            </if>
            <if test="updateTime != null">
                updateTime,
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">
                #{id},
            </if>
            <if test="pid != null">
                #{pid},
            </if>
            <if test="itid != null">
                #{itid},
            </if>
            <if test="iid != null">
                #{iid},
            </if>
            <if test="createTime != null">
                #{createTime},
            </if>
            <if test="updateTime != null">
                #{updateTime},
            </if>
        </trim>
    </insert>
    <insert id="insertMany" parameterType="list" useGeneratedKeys="true" keyProperty="id">
        insert into plan_item
        (pid,
        itid,
        iid,
        createTime,
        updateTime)
        values
        <if test="list != null and list.size>0">
            <foreach collection="list" item="item" separator=",">
                (#{item.pid},#{item.itid},#{item.iid},#{item.createTime},#{item.updateTime})
            </foreach>
        </if>
    </insert>
    <select id="getPlanAndItemListByPid" parameterType="java.lang.Long" resultType="com.bupt.lams.model.PlanAndItem">
        select *
        from plan_item
        where pid = #{pid}
    </select>
    <delete id="deleteManyByOids" parameterType="list">
        delete
        from `order_asset`
        where
        oid in
        <foreach collection="list" close=")" open="(" separator="," item="item">
            #{item}
        </foreach>
    </delete>
    <delete id="deleteManyByAids">
        delete
        from `order_asset`
        <where>
            aid in
            <foreach collection="aids" close=")" open="(" separator="," item="item">
                #{item}
            </foreach>
            <if test="oid !=null">
                and oid = #{oid}
            </if>
        </where>
    </delete>
</mapper>