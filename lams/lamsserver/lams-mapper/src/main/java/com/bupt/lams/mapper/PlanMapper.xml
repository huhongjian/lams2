<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.bupt.lams.mapper.PlanMapper">
    <resultMap id="BaseResultMap" type="com.bupt.lams.model.Plan">
        <id column="id" property="id"/>
        <result column="planName" property="planName"/>
        <result column="projectId" property="projectId"/>
        <result column="projectName" property="projectName"/>
        <result column="userEmail" property="userEmail"/>
        <result column="remark" property="remark"/>
        <result column="funding" property="funding"/>
        <result column="unfulfilledQuota" property="unfulfilledQuota"/>
        <result column="executeRate" property="executeRate"/>
        <result column="createTime" property="createTime"/>
        <result column="updateTime" property="updateTime"/>
    </resultMap>
    <resultMap id="AllInfoResultMap" type="com.bupt.lams.model.Plan" extends="BaseResultMap">
        <association property="user" javaType="com.bupt.lams.model.LamsUser">
            <id column="uid" property="id"/>
            <result column="name" property="name"/>
            <result column="phone" property="phone"/>
            <result column="username" property="username"/>
            <result column="enabled" property="enabled"/>
            <result column="remark" property="remark"/>
        </association>
    </resultMap>
    <sql id="baseInfoQuery">
        <if test="planId !=null">
            and p.id = #{planId}
        </if>
        <if test="projectId !=null">
            and p.projectId = #{projectId}
        </if>
        <if test="planName !=null and planName!=''">
            and p.planName like concat('%',#{planName},'%')
        </if>
        <if test="userEmail !=null and userEmail!=''">
            and p.userEmail like concat('%',#{userEmail},'%')
        </if>
        <if test="startDate !=null and endDate !=null">
            and p.createTime between #{startDate} and #{endDate}
        </if>
    </sql>
    <select id="getPlanByCondition" parameterType="com.bupt.lams.dto.ProjectQueryCondition"
            resultMap="AllInfoResultMap">
        select p.*,
        u.id as uid, u.*,
        pr.projectName
        from
        plan p
        left join lams_user u on p.userEmail = u.username
        left join project pr on p.projectId = pr.id
        <where>
            p.isDeleted = 0
            <include refid="baseInfoQuery"/>
        </where>
        order by p.id
    </select>
    <select id="getAllPlans" resultType="com.bupt.lams.model.Plan">
        select *
        from plan
        where
        isDelected = 0;
    </select>
    <insert id="insertSelective" parameterType="com.bupt.lams.model.Plan" useGeneratedKeys="true" keyProperty="id">
        insert into plan
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="planName != null and planName != ''">
                `planName`,
            </if>
            <if test="projectId != null">
                projectId,
            </if>
            <if test="userEmail != null and userEmail != ''">
                userEmail,
            </if>
            <if test="remark != null and remark != ''">
                remark,
            </if>
            <if test="funding != null">
                funding,
            </if>
            <if test="unfulfilledQuota != null">
                unfulfilledQuota,
            </if>
            <if test="executeRate != null">
                executeRate,
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="planName != null and planName != ''">
                #{planName},
            </if>
            <if test="projectId != null">
                #{projectId},
            </if>
            <if test="userEmail != null and userEmail != ''">
                #{userEmail},
            </if>
            <if test="remark != null and remark != ''">
                #{remark},
            </if>
            <if test="funding != null">
                #{funding},
            </if>
            <if test="unfulfilledQuota != null">
                #{unfulfilledQuota},
            </if>
            <if test="executeRate != null">
                #{executeRate},
            </if>
        </trim>
    </insert>
    <update id="updatePlan" parameterType="com.bupt.lams.model.Plan">
        update plan
        set
        <trim suffixOverrides=",">
            <if test="planName != null and planName != ''">
                `planName` = #{planName},
            </if>
            <if test="projectId != null">
                projectId = #{projectId},
            </if>
            <if test="userEmail != null and userEmail != ''">
                userEmail = #{userEmail},
            </if>
            <if test="remark != null and remark != ''">
                remark = #{remark},
            </if>
            <if test="funding != null">
                funding = #{funding},
            </if>
            <if test="unfulfilledQuota != null">
                unfulfilledQuota = #{unfulfilledQuota},
            </if>
            <if test="executeRate != null">
                executeRate = #{executeRate},
            </if>
            <if test="createTime != null">
                createTime = #{createTime},
            </if>
            updateTime = NOW()
        </trim>
        <where>
            id = #{id}
        </where>
    </update>
    <select id="getPlanById" parameterType="java.lang.Long" resultMap="BaseResultMap">
        select * from plan
        where id = #{id}
    </select>
    <select id="getTotal" resultType="java.lang.Double">
        select sum(p.funding) from plan p where p.isDeleted = 0;
    </select>
    <select id="getPlansByProjectIds" parameterType="list" resultType="com.bupt.lams.model.Plan">
        select *
        from plan p
        where p.isDeleted = 0
        <if test="list != null and list.size>0">
            and p.projectId in
            <foreach collection="list" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
        </if>
        order by p.id;
    </select>
    <update id="deletePlans" parameterType="java.lang.Long">
        update plan
        set
        isDeleted = 1
        <where>
            <if test="list != null and list.size>0">
                and id in
                <foreach collection="list" item="item" open="(" close=")" separator=",">
                    #{item}
                </foreach>
            </if>
        </where>
    </update>
</mapper>