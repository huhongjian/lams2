<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.bupt.lams.mapper.ProjectMapper">
    <resultMap id="BaseResultMap" type="com.bupt.lams.model.Project">
        <id column="id" property="id"/>
        <result column="projectName" property="projectName"/>
        <result column="projectType" property="projectType"/>
        <result column="userEmail" property="userEmail"/>
        <result column="years" property="years"/>
        <result column="funding" property="funding"/>
        <result column="unfulfilledQuota" property="unfulfilledQuota"/>
        <result column="executeRate" property="executeRate"/>
        <result column="createTime" property="createTime"/>
        <result column="updateTime" property="updateTime"/>
    </resultMap>
    <resultMap id="AllInfoResultMap" type="com.bupt.lams.model.Project" extends="BaseResultMap">
        <association property="user" javaType="com.bupt.lams.model.LamsUser">
            <id column="uid" property="id"/>
            <result column="name" property="name"/>
            <result column="phone" property="phone"/>
            <result column="username" property="username"/>
            <result column="enabled" property="enabled"/>
            <result column="remark" property="remark"/>
        </association>
    </resultMap>
    <sql id="baseInfoQuery">
        <if test="projectId !=null">
            and p.id = #{projectId}
        </if>
        <if test="projectName !=null and projectName!=''">
            and p.projectName like concat('%',#{projectName},'%')
        </if>
        <if test="projectType !=null and projectType!=''">
            and p.projectType like concat('%',#{projectType},'%')
        </if>
        <if test="userEmail !=null and userEmail!=''">
            and p.userEmail like concat('%',#{userEmail},'%')
        </if>
        <if test="startDate !=null and endDate !=null">
            and p.createTime between #{startDate} and #{endDate}
        </if>
    </sql>
    <select id="getProjectByCondition" parameterType="com.bupt.lams.dto.ProjectQueryCondition"
            resultMap="AllInfoResultMap">
        select p.*,
        u.id as uid, u.*
        from
        project p
        left join lams_user u on u.username = p.userEmail
        <where>
            <include refid="baseInfoQuery"/>
        </where>
        order by p.id
    </select>
    <select id="getAllProjects" resultType="com.bupt.lams.model.Project">
        select *
        from
        project p
        order by p.id
    </select>
    <select id="getTotalByCondition" parameterType="com.bupt.lams.dto.ProjectQueryCondition"
            resultType="java.lang.Long">
        select count(*)
        project p
        <where>
            <include refid="baseInfoQuery"/>
        </where>
    </select>
    <insert id="insertSelective" parameterType="com.bupt.lams.model.Project" useGeneratedKeys="true" keyProperty="id">
        insert into project
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="projectName != null and projectName != ''">
                `projectName`,
            </if>
            <if test="projectType != null and projectType != ''">
                projectType,
            </if>
            <if test="userEmail != null and userEmail != ''">
                userEmail,
            </if>
            <if test="years != null">
                years,
            </if>
            <if test="funding != null">
                funding,
            </if>
            <if test="unfulfilledQuota != null">
                unfulfilledQuota,
            </if>
            <if test="executeRate != null">
                executeRate,
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="projectName != null and projectName != ''">
                #{projectName},
            </if>
            <if test="projectType != null and projectType != ''">
                #{projectType},
            </if>
            <if test="userEmail != null and userEmail != ''">
                #{userEmail},
            </if>
            <if test="years != null">
                #{years},
            </if>
            <if test="funding != null">
                #{funding},
            </if>
            <if test="funding != null">
                #{funding},
            </if>
            <if test="unfulfilledQuota != null">
                #{unfulfilledQuota},
            </if>
            <if test="executeRate != null">
                #{executeRate},
            </if>
        </trim>
    </insert>
    <update id="updateProject" parameterType="com.bupt.lams.model.Project">
        update project
        set
        <trim suffixOverrides=",">
            <if test="projectName != null and projectName != ''">
                `projectName` = #{projectName},
            </if>
            <if test="projectType != null and projectType != ''">
                projectType = #{projectType},
            </if>
            <if test="userEmail != null and userEmail != ''">
                userEmail = #{userEmail},
            </if>
            <if test="years != null">
                years = #{years},
            </if>
            <if test="funding != null">
                funding = #{funding},
            </if>
            <if test="unfulfilledQuota != null">
                unfulfilledQuota = #{unfulfilledQuota},
            </if>
            <if test="executeRate != null">
                executeRate = #{executeRate},
            </if>
            <if test="createTime != null">
                createTime = #{createTime},
            </if>
            updateTime = NOW()
        </trim>
        <where>
            id = #{id}
        </where>
    </update>
    <select id="getProjectById" parameterType="java.lang.Long" resultType="com.bupt.lams.model.Project">
        select * from project
        where id = #{id}
    </select>
    <select id="getTotal" resultType="java.lang.Double">
        select sum(p.funding) from project p
    </select>
    <select id="getUnfulfilledQuota" resultType="java.lang.Double">
        select sum(p.unfulfilledQuota) from project p
    </select>
    <delete id="deleteProjects" parameterType="list">
        delete
        from `project`
        where
        id in
        <foreach collection="list" close=")" open="(" separator="," item="item">
            #{item}
        </foreach>
    </delete>
</mapper>