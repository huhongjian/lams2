<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.bupt.lams.mapper.PublishFeeMapper">
    <insert id="insertSelective" parameterType="com.bupt.lams.model.planItem.PublishFee" useGeneratedKeys="true"
            keyProperty="id">
        insert into publish_fee
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="itemType != null">
                `itemType`,
            </if>
            <if test="itemTypeName != null and itemTypeName != ''">
                itemTypeName,
            </if>
            <if test="userEmail != null and userEmail != ''">
                userEmail,
            </if>
            <if test="type != null and type != ''">
                `type`,
            </if>
            <if test="remark != null and remark != ''">
                `remark`,
            </if>
            <if test="subTotal != null">
                subTotal,
            </if>
            <if test="unfulfilledQuota != null">
                unfulfilledQuota,
            </if>
            <if test="executeRate != null">
                executeRate,
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="itemType != null">
                #{itemType},
            </if>
            <if test="itemTypeName != null and itemTypeName != ''">
                #{itemTypeName},
            </if>
            <if test="userEmail != null and userEmail != ''">
                #{userEmail},
            </if>
            <if test="type != null and type != ''">
                #{type},
            </if>
            <if test="remark != null and remark != ''">
                #{remark},
            </if>
            <if test="subTotal != null">
                #{subTotal},
            </if>
            <if test="unfulfilledQuota != null">
                #{unfulfilledQuota},
            </if>
            <if test="executeRate != null">
                #{executeRate},
            </if>
        </trim>
    </insert>
    <update id="update" parameterType="com.bupt.lams.model.planItem.PublishFee">
        update publish_fee
        set
        <trim suffixOverrides=",">
            <if test="itemType != null">
                `itemType` = #{itemType},
            </if>
            <if test="itemTypeName != null and itemTypeName != ''">
                itemTypeName = #{itemTypeName},
            </if>
            <if test="type != null and type != ''">
                #{type},
            </if>
            <if test="remark != null and remark != ''">
                #{remark},
            </if>
            <if test="subTotal != null">
                subTotal = #{subTotal},
            </if>
            <if test="unfulfilledQuota != null">
                unfulfilledQuota = #{unfulfilledQuota},
            </if>
            <if test="executeRate != null">
                executeRate = #{executeRate},
            </if>
            <if test="createTime != null">
                createTime = #{createTime},
            </if>
            updateTime = NOW()
        </trim>
        <where>
            id = #{id}
        </where>
    </update>
    <select id="getById" parameterType="java.lang.Long" resultType="com.bupt.lams.model.planItem.PublishFee">
        select p.*
        from
        publish_fee p
        where
        p.id = #{id}
    </select>
    <select id="getPublishFeeByIds" parameterType="list" resultType="com.bupt.lams.model.planItem.PublishFee">
        select p.*
        from
        publish_fee p
        where 1=1
        <if test="list != null and list.size>0">
            and p.id in
            <foreach collection="list" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
        </if>
        order by p.id
    </select>
    <delete id="clear" parameterType="java.lang.String">
        delete t.*
        from publish_fee t
         left join plan_item p on p.iid = t.id
        where
        p.pid is null
        and t.itemType = 8
        and t.userEmail = #{userEmail};
    </delete>
</mapper>