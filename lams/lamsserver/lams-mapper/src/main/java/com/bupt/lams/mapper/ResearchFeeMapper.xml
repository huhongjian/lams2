                #{executeRate},
            </if>
        </trim>
    </insert>
    <select id="getResearchFeeByIds" parameterType="list" resultType="com.bupt.lams.model.planItem.ResearchFee">
        select r.*
        from
        research_fee r
        where 1=1
        <if test="list != null and list.size>0">
            and r.id in
            <foreach collection="list" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
        </if>
        order by r.id
    </select>
    <select id="getFullInfoByIds" parameterType="list" resultType="com.bupt.lams.model.planItem.ResearchFee">
        select t.*, p.id as planId, pr.id as projectId, p.planName, pr.projectName
        from
        research_fee t
        join plan_item pi on t.id = pi.iid
        join plan p on p.id = pi.pid
        join project pr on pr.id = p.projectId
        where pi.itid = 5
        <if test="list != null and list.size>0">
            and t.id in
            <foreach collection="list" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
        </if>
        order by t.id
    </select>
    <update id="update" parameterType="com.bupt.lams.model.planItem.ResearchFee">
        update research_fee
        set
        <trim suffixOverrides=",">
            <if test="itemType != null">
                `itemType` = #{itemType},
            </if>
            <if test="itemTypeName != null and itemTypeName != ''">
                itemTypeName = #{itemTypeName},
            </if>
            <if test="place != null and place != ''">
                place = #{place},
            </if>
            <if test="purpose != null and purpose != ''">
                purpose = #{purpose},
            </if>
            <if test="personnelType != null and personnelType != ''">
                personnelType = #{personnelType},
            </if>
            <if test="times != null">
                times = #{times},
            </if>
            <if test="transFee != null">
                transFee = #{transFee},
            </if>
            <if test="accommodationFee != null">
                accommodationFee = #{accommodationFee},
            </if>
            <if test="otherFee != null">
                otherFee = #{otherFee},
            </if>
            <if test="days != null">
                days = #{days},
            </if>
            <if test="subTotal != null">
                subTotal = #{subTotal},
            </if>
            <if test="remark != null and remark != ''">
                remark = #{remark},
            </if>
            <if test="unfulfilledQuota != null">
                unfulfilledQuota = #{unfulfilledQuota},
            </if>
            <if test="executeRate != null">
                executeRate = #{executeRate},
            </if>
            <if test="createTime != null">
                createTime = #{createTime},
            </if>
            updateTime = NOW()
        </trim>
        <where>
            id = #{id}
        </where>
    </update>
    <select id="getById" parameterType="java.lang.Long" resultType="com.bupt.lams.model.planItem.ResearchFee">
        select t.*, p.id as planId, pr.id as projectId, p.planName, pr.projectName
        from
        research_fee t
        join plan_item pi on t.id = pi.iid
        join plan p on p.id = pi.pid
        join project pr on pr.id = p.projectId
        where
        pi.itid = 5
        and
        t.id = #{id}
    </select>
    <delete id="clear" parameterType="java.lang.String">
        delete t.*
        from research_fee t
         left join plan_item p on p.iid = t.id
        where
        p.pid is null
        and t.itemType = 5
        and t.userEmail = #{userEmail};
    </delete>
    <select id="getAll" resultType="com.bupt.lams.model.planItem.ResearchFee">
        select t.*, p.id as planId, pr.id as projectId, p.planName, pr.projectName
        from
        research_fee t
        join plan_item pi on t.id = pi.iid
        join plan p on  p.id = pi.pid
        join project pr on pr.id = p.projectId
        where
        pi.itid = 5
        order by t.id
    </select>
</mapper>