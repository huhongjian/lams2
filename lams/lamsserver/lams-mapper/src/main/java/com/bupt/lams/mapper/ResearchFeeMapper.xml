<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.bupt.lams.mapper.ResearchFeeMapper">
    <insert id="insertSelective" parameterType="com.bupt.lams.model.planItem.ResearchFee" useGeneratedKeys="true"
            keyProperty="id">
        insert into research_fee
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="itemType != null">
                `itemType`,
            </if>
            <if test="itemTypeName != null and itemTypeName != ''">
                itemTypeName,
            </if>
            <if test="userEmail != null and userEmail != ''">
                userEmail,
            </if>
            <if test="place != null and place != ''">
                `place`,
            </if>
            <if test="purpose != null and purpose != ''">
                `purpose`,
            </if>
            <if test="personnelType != null and personnelType != ''">
                `personnelType`,
            </if>
            <if test="times != null">
                times,
            </if>
            <if test="transFee != null">
                transFee,
            </if>
            <if test="accommodationFee != null">
                accommodationFee,
            </if>
            <if test="otherFee != null">
                otherFee,
            </if>
            <if test="days != null">
                days,
            </if>
            <if test="subTotal != null">
                subTotal,
            </if>
            <if test="remark != null and remark != ''">
                remark,
            </if>
            <if test="unfulfilledQuota != null">
                unfulfilledQuota,
            </if>
            <if test="executeRate != null">
                executeRate,
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="itemType != null">
                #{itemType},
            </if>
            <if test="itemTypeName != null and itemTypeName != ''">
                #{itemTypeName},
            </if>
            <if test="userEmail != null and userEmail != ''">
                #{userEmail},
            </if>
            <if test="place != null and place != ''">
                #{place},
            </if>
            <if test="purpose != null and purpose != ''">
                #{purpose},
            </if>
            <if test="personnelType != null and personnelType != ''">
                #{personnelType},
            </if>
            <if test="times != null">
                #{times},
            </if>
            <if test="transFee != null">
                #{transFee},
            </if>
            <if test="accommodationFee != null">
                #{accommodationFee},
            </if>
            <if test="otherFee != null">
                #{otherFee},
            </if>
            <if test="days != null">
                #{days},
            </if>
            <if test="subTotal != null">
                #{subTotal},
            </if>
            <if test="remark != null and remark != ''">
                #{remark},
            </if>
