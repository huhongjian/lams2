<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.bupt.lams.mapper.TransportationFeeMapper">
    <insert id="insertSelective" parameterType="com.bupt.lams.model.planItem.PlanItem" useGeneratedKeys="true"
            keyProperty="id">
        insert into transportation_fee
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="itemType != null">
                `itemType`,
            </if>
            <if test="itemTypeName != null and itemTypeName != ''">
                itemTypeName,
            </if>
            <if test="userEmail != null and userEmail != ''">
                userEmail,
            </if>
            <if test="remark != null and remark != ''">
                `remark`,
            </if>
            <if test="subTotal != null">
                subTotal,
            </if>
            <if test="unfulfilledQuota != null">
                unfulfilledQuota,
            </if>
            <if test="executeRate != null">
                executeRate,
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="itemType != null">
                #{itemType},
            </if>
            <if test="itemTypeName != null and itemTypeName != ''">
                #{itemTypeName},
            </if>
            <if test="userEmail != null and userEmail != ''">
                #{userEmail},
            </if>
            <if test="remark != null and remark != ''">
                #{remark},
            </if>
            <if test="subTotal != null">
                #{subTotal},
            </if>
            <if test="unfulfilledQuota != null">
                #{unfulfilledQuota},
            </if>
            <if test="executeRate != null">
                #{executeRate},
            </if>
        </trim>
    </insert>
    <update id="update" parameterType="com.bupt.lams.model.planItem.PlanItem">
        update transportation_fee
        set
        <trim suffixOverrides=",">
            <if test="itemType != null">
                `itemType` = #{itemType},
            </if>
            <if test="itemTypeName != null and itemTypeName != ''">
                itemTypeName = #{itemTypeName},
            </if>
            <if test="remark != null and remark != ''">
                remark = #{remark},
            </if>
            <if test="subTotal != null">
                subTotal = #{subTotal},
            </if>
            <if test="unfulfilledQuota != null">
                unfulfilledQuota = #{unfulfilledQuota},
            </if>
            <if test="executeRate != null">
                executeRate = #{executeRate},
            </if>
            <if test="createTime != null">
                createTime = #{createTime},
            </if>
            updateTime = NOW()
        </trim>
        <where>
            id = #{id}
        </where>
    </update>
    <select id="getById" parameterType="java.lang.Long" resultType="com.bupt.lams.model.planItem.PlanItem">
        select t.*, p.id as planId, pr.id as projectId, p.planName, pr.projectName
        from
        transportation_fee t
        join plan_item pi on t.id = pi.iid
        join plan p on p.id = pi.pid
        join project pr on pr.id = p.projectId
        where
        pi.itid = 7
        and
        t.id = #{id}
    </select>
    <select id="getTransportationFeeByIds" parameterType="list" resultType="com.bupt.lams.model.planItem.PlanItem">
        select t.*
        from
        transportation_fee t
        where 1=1
        <if test="list != null and list.size>0">
            and t.id in
            <foreach collection="list" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
        </if>
        order by t.id
    </select>
    <select id="getFullInfoByIds" parameterType="list" resultType="com.bupt.lams.model.planItem.PlanItem">
        select t.*, p.id as planId, pr.id as projectId, p.planName, pr.projectName
        from
        transportation_fee t
        join plan_item pi on t.id = pi.iid
        join plan p on p.id = pi.pid
        join project pr on pr.id = p.projectId
        where pi.itid = 7
        <if test="list != null and list.size>0">
            and t.id in
            <foreach collection="list" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
        </if>
        order by t.id
    </select>
    <delete id="clear" parameterType="java.lang.String">
        delete t.*
        from transportation_fee t
         left join plan_item p on p.iid = t.id
        where
        p.pid is null
        and t.itemType = 7
        and t.userEmail = #{userEmail};
    </delete>
    <select id="getAll" resultType="com.bupt.lams.model.planItem.PlanItem">
        select t.*, p.id as planId, pr.id as projectId, p.planName, pr.projectName
        from
        transportation_fee t
        join plan_item pi on t.id = pi.iid
        join plan p on  p.id = pi.pid
        join project pr on pr.id = p.projectId
        where
        pi.itid = 7
        and
        p.isDeleted = 0
        order by t.id
    </select>
</mapper>