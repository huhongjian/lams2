<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.bupt.lams.mapper.WarningConfigMapper">
    <sql id="baseInfoQuery">
        <if test="id !=null">
            and w.id = #{id}
        </if>
        <if test="freq !=null">
            and w.freq = #{freq}
        </if>
        <if test="planId !=null">
            and w.planId = #{planId}
        </if>
        <if test="projectId !=null">
            and w.projectId = #{projectId}
        </if>
        <if test="itemType !=null">
            and w.itemType = #{itemType}
        </if>
        <if test="currentDate !=null">
            and #{currentDate} between w.startTime and w.endTime
        </if>
        <if test="userEmail !=null and userEmail!=''">
            and w.userEmail like concat('%',#{userEmail},'%')
        </if>
        <if test="startDate !=null and endDate !=null">
            and w.createTime between #{startDate} and #{endDate}
        </if>
    </sql>
    <select id="getWarningConfigByCondition" parameterType="com.bupt.lams.dto.WarningConfigQueryCondition"
            resultType="com.bupt.lams.model.WarningConfig">
        select w.*,
        p.planName, pr.projectName
        from
        warning_config w
        left join plan p on p.id = w.planId
        left join project pr on pr.id = w.projectId
        <where>
            <include refid="baseInfoQuery"/>
        </where>
        order by w.id
    </select>
    <insert id="insertSelective" parameterType="com.bupt.lams.model.WarningConfig" useGeneratedKeys="true"
            keyProperty="id">
        insert into warning_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="projectId != null">
                projectId,
            </if>
            <if test="planId != null">
                planId,
            </if>
            <if test="itemType != null">
                itemType,
            </if>
            <if test="itemTypeName != null and itemTypeName != ''">
                `itemTypeName`,
            </if>
            <if test="executeRate != null">
                executeRate,
            </if>
            <if test="configStatus != null">
                configStatus,
            </if>
            <if test="configStatusName != null and configStatusName != ''">
                configStatusName,
            </if>
            <if test="userEmail != null and userEmail != ''">
                userEmail,
            </if>
            <if test="toUserString != null and toUserString != ''">
                toUserString,
            </if>
            <if test="startTime != null">
                startTime,
            </if>
            <if test="endTime != null">
                endTime,
            </if>
            <if test="freq != null">
                freq,
            </if>
            <if test="freqName != null and freqName != ''">
                freqName,
            </if>
            <if test="advice != null and advice != ''">
                advice,
            </if>
            <if test="createTime != null">
                createTime,
            </if>
            <if test="updateTime != null">
                updateTime,
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="projectId != null">
                #{projectId},
            </if>
            <if test="planId != null">
                #{planId},
            </if>
            <if test="itemType != null">
                #{itemType},
            </if>
            <if test="itemTypeName != null and itemTypeName != ''">
                #{itemTypeName},
            </if>
            <if test="executeRate != null">
                #{executeRate},
            </if>
            <if test="configStatus != null">
                #{configStatus},
            </if>
            <if test="configStatusName != null and configStatusName != ''">
                #{configStatusName},
            </if>
            <if test="userEmail != null and userEmail != ''">
                #{userEmail},
            </if>
            <if test="toUserString != null and toUserString != ''">
                #{toUserString},
            </if>
            <if test="startTime != null">
                #{startTime},
            </if>
            <if test="endTime != null">
                #{endTime},
            </if>
            <if test="freq != null">
                #{freq},
            </if>
            <if test="freqName != null and freqName != ''">
                #{freqName},
            </if>
            <if test="advice != null and advice != ''">
                #{advice},
            </if>
            <if test="createTime != null">
                #{createTime},
            </if>
            <if test="updateTime != null">
                #{updateTime},
            </if>
        </trim>
    </insert>
    <update id="update" parameterType="com.bupt.lams.model.WarningConfig">
        update warning_config
        set
        <trim suffixOverrides=",">
            <if test="projectId != null">
                projectId = #{projectId},
            </if>
            <if test="planId != null">
                planId = #{planId},
            </if>
            <if test="itemType != null">
                itemType = #{itemType},
            </if>
            <if test="itemTypeName != null and itemTypeName != ''">
                itemTypeName = #{itemTypeName},
            </if>
            <if test="executeRate != null">
                executeRate = #{executeRate},
            </if>
            <if test="configStatus != null">
                configStatus = #{configStatus},
            </if>
            <if test="configStatusName != null and configStatusName != ''">
                configStatusName = #{configStatusName},
            </if>
            <if test="userEmail != null and userEmail != ''">
                userEmail = #{userEmail},
            </if>
            <if test="toUserString != null and toUserString != ''">
                toUserString = #{toUserString},
            </if>
            <if test="startTime != null">
                startTime = #{startTime},
            </if>
            <if test="endTime != null">
                endTime = #{endTime},
            </if>
            <if test="freq != null">
                freq = #{freq},
            </if>
            <if test="freqName != null and freqName != ''">
                freqName = #{freqName},
            </if>
            <if test="advice != null and advice != ''">
                advice = #{advice},
            </if>
            <if test="createTime != null">
                createTime = #{createTime},
            </if>
            updateTime = NOW()
        </trim>
        <where>
            id = #{id}
        </where>
    </update>
    <delete id="deleteConfigs" parameterType="list">
        delete
        from warning_config
        where
        id in
        <foreach collection="list" close=")" open="(" separator="," item="item">
            #{item}
        </foreach>
    </delete>
</mapper>